#the mod name as displayed in-game
displayName: "Batch Configuration"

#the internal name of your mod
name: "batch-config"

#your name
author: "Bilibili:arknights player / Github:undefined-1026"

#the fully qualified main class of the mod
main: "mod.BatchConfigurationMod"

#the mod description as seen in the mod dialog
description: "按指定键选择一个建筑，然后按住另一个键框选多个建筑的并以选择批量配置\n默认按键是h和h\n因为anuken没留绝对位置api所以你只能在单人里将处理器配置为同样的连接"

#the mod version
version: 1.0

#the minimum game build required to run this mod
minGameVersion: 160.3

#this is a java mod
java: true

hidden: true